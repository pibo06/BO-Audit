@page
@model IndexModel
@using BOAudit.Models
@{
    ViewData["Title"] = "Suivi des publications BO";
    var isRecipients = string.Equals(Model.View, "destinataires", StringComparison.OrdinalIgnoreCase);
    var isPlanifications = string.Equals(Model.View, "planifications", StringComparison.OrdinalIgnoreCase);
}

<div class="container">
    <h1 class="mb-1">Suivi des publications BO</h1>
    <p class="text-muted">Publications, destinataires, planning et état des envois SAP BusinessObjects.</p>

    @if (TempData["SuccessMessage"] is string ok)
    {
        <div class="alert alert-success alert-dismissible">@ok
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] is string ko)
    {
        <div class="alert alert-danger alert-dismissible">@ko
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
    }
    @if (Model.ErrorMessage != null)
    {
        <div class="alert alert-warning">Erreur signalée au dernier rafraîchissement : @Model.ErrorMessage</div>
    }

    <div class="d-flex flex-wrap align-items-center gap-3 mb-4 border-bottom pb-3">
        <form method="post" asp-page-handler="Refresh" asp-route-view="@Model.View">
            <button type="submit" class="btn btn-primary">
                <span aria-hidden="true">&#8635;</span> Rafraîchir les données BO
            </button>
        </form>
        <span class="text-muted">
            @if (Model.LastRefresh is { } last)
            {
                <text>Dernière actualisation : <strong>@Display.Date(last)</strong></text>
            }
            else
            {
                <text>Aucune donnée chargée — cliquez sur « Rafraîchir les données BO ».</text>
            }
        </span>
        <span class="ms-auto btn-group" role="group" aria-label="Choix de la vue">
            <a asp-page="./Index" asp-route-view="cartes" class="btn btn-outline-secondary btn-view-pub @(isRecipients || isPlanifications ? "" : "active")">Publications</a>
            <a asp-page="./Index" asp-route-view="planifications" class="btn btn-outline-secondary btn-view-plan @(isPlanifications ? "active" : "")">Planifications</a>
            <a asp-page="./Index" asp-route-view="destinataires" class="btn btn-outline-secondary @(isRecipients ? "active" : "")">Destinataires</a>
        </span>
    </div>

    @if (isPlanifications)
    {
        // ---- Vue planifications : documents Webi planifiés ----
        @if (Model.Planifications.Count == 0)
        {
            <div class="alert alert-info">Aucune planification chargée. Lancez un rafraîchissement pour charger les planifications depuis BO.</div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
                @foreach (var planification in Model.Planifications)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm card-plan">
                            <div class="card-body">
                                <h5 class="card-title">@planification.Name</h5>
                                <p class="card-text small text-muted">
                                    @(string.IsNullOrEmpty(planification.Description) ? "Pas de description" : planification.Description)
                                </p>
                                <ul class="list-unstyled small mb-2">
                                    <li>
                                        <span class="badge @Display.ScheduleEndBadgeClass(planification.EndTime)">
                                            @Display.ScheduleEndLabel(planification.EndTime)@(planification.EndTime is { } end ? $" : {Display.Date(end)}" : "")
                                        </span>
                                    </li>
                                    <li>
                                        Récurrence : @(planification.Recurrence ?? "—")
                                    </li>
                                    <li>
                                        Dernière exécution :
                                        @(planification.LastRunTime is { } lastRun ? Display.Date(lastRun) : "jamais")
                                        (@planification.InstanceCount instance(s))
                                    </li>
                                    <li>
                                        Format : @(planification.Format ?? "—")
                                        @if (planification.HasPrompts)
                                        {
                                            <span class="badge bg-light text-dark border" title="Le document comporte des invites">invites</span>
                                        }
                                    </li>
                                    <li>
                                        Destinataires :
                                        @if (planification.UsesDynamicSmtpRecipients)
                                        {
                                            <span class="badge bg-info text-dark">dynamiques</span>
                                        }
                                        @if (planification.StaticEmails.Count > 0)
                                        {
                                            <text>@planification.StaticEmails.Count</text>
                                        }
                                        @if (!planification.UsesDynamicSmtpRecipients && planification.StaticEmails.Count == 0)
                                        {
                                            <text>—</text>
                                        }
                                    </li>
                                    @if (planification.Error != null)
                                    {
                                        <li class="text-danger">Erreur : @planification.Error</li>
                                    }
                                </ul>
                                <a asp-page="/Planification/Detail" asp-route-id="@planification.Id" class="btn btn-sm btn-primary">Voir le détail</a>
                            </div>
                            <div class="card-footer small text-muted">
                                @if (!string.IsNullOrEmpty(planification.Folder))
                                {
                                    <text>Dossier : <strong>@planification.Folder</strong> — </text>
                                }
                                Auteur : @(string.IsNullOrEmpty(planification.Author) ? "—" : planification.Author) — Modifié : @Display.Date(planification.Updated)
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else if (!isRecipients)
    {
        // ---- Vue cartes : publications avec informations de base ----
        @if (Model.Publications.Count == 0)
        {
            <div class="alert alert-info">Aucune donnée. Lancez un rafraîchissement pour charger les publications depuis BO.</div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
                @foreach (var publication in Model.Publications)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm card-pub">
                            <div class="card-body">
                                <h5 class="card-title">@publication.Name</h5>
                                <p class="card-text small text-muted">
                                    @(string.IsNullOrEmpty(publication.Description) ? "Pas de description" : publication.Description)
                                </p>
                                <ul class="list-unstyled small mb-2">
                                    <li>
                                        État dernier envoi :
                                        @if (publication.LastRunStatus != null || publication.ScheduleStatus != null)
                                        {
                                            var status = publication.LastRunStatus ?? publication.ScheduleStatus;
                                            <span class="badge @Display.StatusBadgeClass(status)">@Display.StatusLabel(status)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inconnu</span>
                                        }
                                        @if (publication.LastRunTime is { } lastRun)
                                        {
                                            <text> — @Display.Date(lastRun)</text>
                                        }
                                    </li>
                                    <li>
                                        Prochaine publication :
                                        @(publication.NextRunTime is { } next ? Display.Date(next) : "aucune planification")
                                    </li>
                                    <li>
                                        Destinataires :
                                        @(publication.StaticEmails.Count + (publication.UsesDynamicSmtpRecipients || publication.DynamicRecipientColumns.Count > 0 ? 1 : 0)) défini(s)
                                        @if (publication.UsesDynamicSmtpRecipients || publication.DynamicRecipientColumns.Count > 0)
                                        {
                                            <span class="badge bg-info text-dark">dynamiques</span>
                                        }
                                    </li>
                                    @if (publication.Error != null)
                                    {
                                        <li class="text-danger">Erreur : @publication.Error</li>
                                    }
                                </ul>
                                <a asp-page="/Publication/Detail" asp-route-id="@publication.Id" class="btn btn-sm btn-primary">Voir le détail</a>
                            </div>
                            <div class="card-footer small text-muted">
                                @if (!string.IsNullOrEmpty(publication.Folder))
                                {
                                    <text>Dossier : <strong>@publication.Folder</strong> — </text>
                                }
                                Auteur : @publication.Author — Modifié : @Display.Date(publication.Updated)
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        // ---- Vue destinataires référencés dans les publications ----
        @if (Model.Recipients.Count == 0)
        {
            <div class="alert alert-info">Aucun destinataire e-mail statique identifié dans les publications ni dans les planifications.
                Lancez d'abord un rafraîchissement, ou les envois utilisent uniquement des destinataires dynamiques (voir leurs détails).</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>E-mail</th>
                            <th>Nom</th>
                            <th>Prénom</th>
                            <th>Sortie</th>
                            <th>Publications / Planifications</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var recipient in Model.Recipients)
                        {
                            // Destinataire absent de la vue [Vue_MailPro] : ligne mise en avant en orange.
                            <tr class="@(recipient.FoundInDatabase ? "" : "table-warning")">
                                <td>@recipient.Email</td>
                                <td>
                                    @if (recipient.FoundInDatabase)
                                    {
                                        @(string.IsNullOrEmpty(recipient.Nom) ? "—" : recipient.Nom)
                                    }
                                    else
                                    {
                                        <strong>Non trouvé en base</strong>
                                    }
                                </td>
                                <td>@(recipient.Prenom ?? "—")</td>
                                <td>
                                    @(recipient.DateSortie is { } sortie ? Display.Date(sortie) : "")
                                </td>
                                <td>
                                    @foreach (var publication in recipient.Publications)
                                    {
                                        <a asp-page="/Publication/Detail" asp-route-id="@publication.Id" class="badge badge-pub">@publication.Name</a>
                                    }
                                    @foreach (var planification in recipient.Planifications)
                                    {
                                        <a asp-page="/Planification/Detail" asp-route-id="@planification.Id" class="badge badge-plan">@planification.Name</a>
                                    }
                                    @if (recipient.Publications.Count == 0 && recipient.Planifications.Count == 0)
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>
